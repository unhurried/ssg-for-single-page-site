---
// Starlight builds two columns here, the body and a right sidebar (the TOC), but the TOC is
// merged into the left sidebar, so the right column is dropped for a single body column.
// (Together with src/components/Sidebar.astro: left = TOC, center = body.)
---

<div class="lg:sl-flex">
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
			width: 100%;
		}
	}
</style>
