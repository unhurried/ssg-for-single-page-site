---
// Nested TOC list: the heading hierarchy becomes nested <ul>s.
// The depth is passed to each element as --depth and used for the indent (src/styles/toc.css).
interface TocItem {
	slug: string;
	text: string;
	children: TocItem[];
}

interface Props {
	toc: TocItem[];
	depth?: number;
}

const { toc, depth = 0 } = Astro.props;
---

<ul style={`--depth: ${depth}`}>
	{
		toc.map((heading) => (
			<li>
				<a href={'#' + heading.slug}>
					<span>{heading.text}</span>
				</a>
				{heading.children.length > 0 && <Astro.self toc={heading.children} depth={depth + 1} />}
			</li>
		))
	}
</ul>
